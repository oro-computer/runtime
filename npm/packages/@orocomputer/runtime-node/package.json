  "bugs": {
    "url": "https://github.com/oro-computer/runtime/issues"
  },
  "homepage": "https://oro.computer/runtime",
  "devDependencies": {
    "@types/node": "20.7.0",
    "esbuild": "0.19.3",
    "standard": "^17.1.0"
  }
}
