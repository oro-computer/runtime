{
  "name": "@orocomputer/runtime-node",
  "version": "0.1.0",
  "description": "Oro Runtime Node adapter",
  "main": "index.js",
  "exports": {
    "import": "./index.js",
    "require": "./index.cjs"
  },
  "type": "module",
  "scripts": {
    "test": "standard index.js",
    "pub": "npm pub && npm publish --registry https://npm.pkg.github.com",
