{
  "schema": 1,
  "workflows": [
    {
      "id": "public-read",
      "request": {
        "url": "https://example.invalid/public/alerts",
        "timeoutMs": 5000,
        "maximumResponseBytes": 65536,
        "cursorParameter": "after",
        "pollIntervalMs": 5000
      },
      "response": {
        "items": "/alerts",
        "eventId": "/id",
        "checks": [
          {
            "pointer": "/accountRef",
            "equalsRef": "accountRef"
          },
          {
            "pointer": "/targetRef",
            "equalsRef": "targetRef"
          }
        ],
        "cursor": "/cursor"
      },
      "notification": {
        "title": "/title",
        "body": "/body",
        "channel": "public.workflow",
        "publicVersion": {
          "title": "Public workflow check",
          "body": "Public test data"
        }
      },
      "channels": [
        {
          "id": "public.workflow",
          "name": "Public workflow",
          "importance": "default",
          "sound": "none"
        }
      ]
    }
  ]
}
