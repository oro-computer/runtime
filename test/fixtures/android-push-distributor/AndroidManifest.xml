<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries><package android:name="dev.oro.push" /></queries>
  <application android:label="Oro public push check" android:allowBackup="false" android:debuggable="true" android:theme="@android:style/Theme.Material.Light.NoActionBar">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity>
    <receiver android:name=".ConnectorReceiver" android:exported="true">
      <intent-filter>
        <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
        <action android:name="org.unifiedpush.android.connector.MESSAGE" />
        <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
        <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
      </intent-filter>
    </receiver>
    <service android:name=".ForegroundService" android:exported="true">
      <intent-filter><action android:name="org.unifiedpush.android.connector.RAISE_TO_FOREGROUND" /></intent-filter>
    </service>
    <receiver android:name=".ControlReceiver" android:exported="true" android:permission="android.permission.DUMP">
      <intent-filter><action android:name="dev.oro.push.qualification.OPERATE" /></intent-filter>
    </receiver>
  </application>
  <instrumentation android:name=".EnableDistributor" android:targetPackage="dev.oro.push" />
</manifest>
