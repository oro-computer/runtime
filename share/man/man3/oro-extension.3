.TH ORO-EXTENSION 3 "" "Oro Runtime" "Oro Runtime API Manual"
.SH NAME
oro:extension \- JavaScript API module
.SH SYNOPSIS
.nf
import * as module from 'oro:extension'
.fi
.SH DESCRIPTION
.PP
import extension from 'oro:extension' const ex = await extension.load('native_extension') const result = ex.binding.method('argument')
