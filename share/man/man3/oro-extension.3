.TH ORO-EXTENSION 3 "" "Oro Runtime" "Oro Runtime API Manual"
.SH NAME
oro\-extension \- public C extension ABI for Oro Runtime
.SH SYNOPSIS
.nf
#include <oro/extension.h>
.fi
.SH DESCRIPTION
.PP
The oro/extension.h header defines the native extension ABI used by Oro Runtime loadable modules and embedders.
.PP
It includes the extension registration contract, extension context lifecycle helpers, JSON construction macros and types, IPC bridge types, runtime service metadata, and the canonical oapi_* entry points.
.SH MACROS
.TP
\fBORO_RUNTIME_EXTENSION_ABI_VERSION_MAJOR\fR
.nf
#define ORO_RUNTIME_EXTENSION_ABI_VERSION_MAJOR (unsigned int) 0
.fi
.PP
Major version of the extension ABI.
.TP
\fBORO_RUNTIME_EXTENSION_ABI_VERSION_MINOR\fR
.nf
#define ORO_RUNTIME_EXTENSION_ABI_VERSION_MINOR (unsigned int) 0
.fi
.PP
Minor version of the extension ABI.
.TP
\fBORO_RUNTIME_EXTENSION_ABI_VERSION_PATCH\fR
.nf
#define ORO_RUNTIME_EXTENSION_ABI_VERSION_PATCH (unsigned int) 3
.fi
.PP
Patch version of the extension ABI.
.TP
\fBORO_RUNTIME_EXTENSION_ABI_VERSION\fR
.nf
#define ORO_RUNTIME_EXTENSION_ABI_VERSION ((int) (
ORO_RUNTIME_EXTENSION_ABI_VERSION_MAJOR << 16 |
ORO_RUNTIME_EXTENSION_ABI_VERSION_MINOR << 8 |
ORO_RUNTIME_EXTENSION_ABI_VERSION_PATCH << 0 ))
.fi
.PP
The packed version of the extension ABI useful for semantic comparison purposes.
